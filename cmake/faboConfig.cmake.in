@PACKAGE_INIT@

unset(fabo_NOT_FOUND_MESSAGE)
include("${CMAKE_CURRENT_LIST_DIR}/faboCoreTargets.cmake")
foreach(_fabo_component IN LISTS fabo_FIND_COMPONENTS)
    set(fabo_${_fabo_component}_FOUND FALSE)
    if(_fabo_component STREQUAL "simd" AND @FABO_ENABLE_SIMD@)
        if(NOT TARGET hwy::hwy)
            find_package(hwy 1.4.0 CONFIG QUIET)
        endif()
        if(TARGET hwy::hwy)
            include("${CMAKE_CURRENT_LIST_DIR}/faboSimdTargets.cmake")
            set(fabo_simd_FOUND TRUE)
        elseif(fabo_FIND_REQUIRED_simd)
            string(APPEND fabo_NOT_FOUND_MESSAGE " FABO simd requires Highway >= 1.4.0.")
        endif()
    elseif(_fabo_component STREQUAL "cuda" AND @FABO_ENABLE_CUDA@)
        if(NOT TARGET CUDA::cudart)
            find_package(CUDAToolkit QUIET)
        endif()
        if(TARGET CUDA::cudart)
            include("${CMAKE_CURRENT_LIST_DIR}/faboCudaTargets.cmake")
            set(fabo_cuda_FOUND TRUE)
        elseif(fabo_FIND_REQUIRED_cuda)
            string(APPEND fabo_NOT_FOUND_MESSAGE " FABO cuda requires CUDA::cudart.")
        endif()
    elseif(fabo_FIND_REQUIRED_${_fabo_component})
        string(APPEND fabo_NOT_FOUND_MESSAGE " Unsupported or unavailable FABO component: ${_fabo_component}.")
    endif()
endforeach()
unset(_fabo_component)
check_required_components(fabo)
